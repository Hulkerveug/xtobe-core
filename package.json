{
  "name": "xtobe-core",
  "version": "1.0.0",
  "description": "Xtobe - Omnichannel E2EE Lead Acquisition & Routing Protocol",
  "main": "src/index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:ios": "cd ios && xcodebuild -workspace XtobeCore.xcworkspace -scheme XtobeCore -configuration Release",
    "build:android": "cd android && ./gradlew bundleRelease",
    "build:huawei": "cd android && ./gradlew assembleRelease",
    "test": "jest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-notifications": "~0.28.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "@react-native-firebase/messaging": "^18.7.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "react-native-encrypted-storage": "^4.0.3",
    "zustand": "^4.5.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.4.0",
    "jest": "^29.7.0",
    "eslint": "^8.57.0"
  },
  "private": true
}
