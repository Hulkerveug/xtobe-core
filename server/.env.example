# Xtobe Core — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# ─── Server ────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./xtobe.db

# ─── WhatsApp Cloud API ────────────────────────────────────────────────
# Get these from: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=xtobe_verify_token_2026
WHATSAPP_WEBHOOK_PORT=8081

# ─── Instagram Graph API ───────────────────────────────────────────────
# Get these from: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=xtobe_instagram_verify_2026
INSTAGRAM_WEBHOOK_PORT=8082

# ─── Meta App (shared) ─────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# ─── Relay Server ──────────────────────────────────────────────────────
RELAY_WS_URL=ws://localhost:8080

# ─── Push Notifications ────────────────────────────────────────────────
# Firebase Cloud Messaging (Android)
FCM_SERVER_KEY=
# Apple Push Notification service (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Huawei Push Kit (Huawei devices)
HMS_CLIENT_ID=
HMS_CLIENT_SECRET=
